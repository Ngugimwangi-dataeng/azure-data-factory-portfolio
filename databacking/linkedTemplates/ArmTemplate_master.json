{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "databacking"
		},
		"fromgit_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'fromgit'"
		},
		"moneylinkedadl_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'moneylinkedadl'"
		},
		"projlinkstring_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'projlinkstring'"
		},
		"fromgit_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://recvbackup.dfs.core.windows.net/"
		},
		"moneylinkedadl_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://monayaccount.dfs.core.windows.net/"
		},
		"projlinkstring_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://projectno1storage.dfs.core.windows.net/"
		},
		"source_git_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://raw.githubusercontent.com"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "databacking_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"fromgit_accountKey": {
						"value": "[parameters('fromgit_accountKey')]"
					},
					"moneylinkedadl_accountKey": {
						"value": "[parameters('moneylinkedadl_accountKey')]"
					},
					"projlinkstring_accountKey": {
						"value": "[parameters('projlinkstring_accountKey')]"
					},
					"fromgit_properties_typeProperties_url": {
						"value": "[parameters('fromgit_properties_typeProperties_url')]"
					},
					"moneylinkedadl_properties_typeProperties_url": {
						"value": "[parameters('moneylinkedadl_properties_typeProperties_url')]"
					},
					"projlinkstring_properties_typeProperties_url": {
						"value": "[parameters('projlinkstring_properties_typeProperties_url')]"
					},
					"source_git_properties_typeProperties_url": {
						"value": "[parameters('source_git_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}